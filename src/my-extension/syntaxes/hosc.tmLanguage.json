{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HOSC",
  "scopeName": "source.hosc",
  "fileTypes": ["hosc"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#package-decl" },
    { "include": "#import-stmt" },
    { "include": "#func-decl" },
    { "include": "#framework-keywords" },
    { "include": "#control-keywords" },
    { "include": "#storage-keywords" },
    { "include": "#print-stmt" },
    { "include": "#prints-stmt" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#raw-strings" },
    { "include": "#dotted-call" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.hosc", "match": "//.*$" },
        { "name": "comment.block.hosc", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "package-decl": {
      "match": "\\b(package)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.package.hosc" },
        "2": { "name": "entity.name.namespace.hosc" }
      }
    },
    "import-stmt": {
      "match": "\\b(import)\\b",
      "name": "keyword.control.import.hosc"
    },
    "func-decl": {
      "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.func.hosc" },
        "2": { "name": "entity.name.function.hosc" }
      }
    },
    "control-keywords": {
      "match": "\\b(if|else|while|for|switch|case|default|return|break|continue)\\b",
      "name": "keyword.control.hosc"
    },
    "storage-keywords": {
      "match": "\\b(var|let|const)\\b",
      "name": "storage.type.hosc"
    },
    "framework-keywords": {
      "match": "\\b(window|text)\\b",
      "name": "keyword.control.framework.hosc"
    },
    "print-stmt": {
      "match": "\\b(print)\\b",
      "name": "keyword.other.print.hosc"
    },
    "prints-stmt": {
      "match": "\\b(prints)\\b",
      "name": "keyword.other.prints.hosc"
    },
    "constants": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.hosc"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hosc",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hosc",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.hosc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.hosc", "match": "\\\\[nrt\"\\\\]" },
        { "name": "invalid.illegal.newline.hosc", "match": "\\n" }
      ]
    },
    "raw-strings": {
      "name": "string.quoted.other.raw.hosc",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "name": "constant.character.escape.hosc", "match": "\\\\`" }
      ]
    },
    "dotted-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.[a-zA-Z_][a-zA-Z0-9_]*)+\\b",
      "captures": {
        "1": { "name": "entity.name.namespace.hosc" },
        "2": { "name": "entity.name.function.member.hosc" }
      }
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.hosc" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.hosc", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.hosc", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.hosc", "match": "\\+|\\-|\\*|/|%" },
        { "name": "keyword.operator.assignment.hosc", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.hosc", "match": ";" },
        { "name": "punctuation.separator.comma.hosc", "match": "," },
        { "name": "punctuation.accessor.hosc", "match": "\\." }
      ]
    }
  }
}